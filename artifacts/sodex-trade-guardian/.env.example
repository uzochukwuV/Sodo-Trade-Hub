# ---- Network selection ----
SODEX_NETWORK=testnet                 # "mainnet" | "testnet"

# ---- REST endpoints (from SoDEX docs: /documentation/trading-api/trading-api) ----
SODEX_MAINNET_PERPS_ENDPOINT=https://mainnet-gw.sodex.dev/api/v1/perps
SODEX_MAINNET_SPOT_ENDPOINT=https://mainnet-gw.sodex.dev/api/v1/spot
SODEX_TESTNET_PERPS_ENDPOINT=https://testnet-gw.sodex.dev/api/v1/perps
SODEX_TESTNET_SPOT_ENDPOINT=https://testnet-gw.sodex.dev/api/v1/spot

# Chain IDs used inside signed EIP-712 messages (message.chainID), per docs.
SODEX_MAINNET_CHAIN_ID=286623
SODEX_TESTNET_CHAIN_ID=138565

# Arbitrary domain.chainId sent as X-API-Chain for addAPIKey / permissioned-key flows.
# Docs: "This value may be any uint64; it identifies the signature domain and does
# not select the Sodex network." Pick one value and keep it stable per deployment.
SODEX_API_CHAIN=1

# ---- Master wallet (account owner) ----
# NEVER commit this. Used ONLY for addAPIKey / revokeAPIKey / approveBuilderFee.
SODEX_MASTER_WALLET_ADDRESS=0xYourMasterWalletAddress
SODEX_MASTER_WALLET_PRIVATE_KEY=0xYourMasterWalletPrivateKeyKeepThisOffline

# ---- At-rest encryption for automation API keys ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Redis (trade state, nonce counters, batching, idempotency) ----
REDIS_URL=redis://localhost:6379/0

# ---- AI batch decision engine ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Notifications (optional) ----
# Any JSON-accepting webhook: Slack incoming webhook, a Telegram bot relay, etc.
NOTIFY_WEBHOOK_URL=

# ---- Execution service tuning ----
MAX_ORDERS_PER_BATCH_REQUEST=100
AI_BATCH_SIZE=20
EVALUATION_WORKERS=4

# ---- Standalone Guardian API ----
GUARDIAN_API_PORT=9100
